# ============================================================
# CONFIGURACIÓN META WHATSAPP BUSINESS API
# ============================================================
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=123456789012345
META_WABA_ID=123456789012345
META_APP_ID=123456789012345
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxx
META_WEBHOOK_VERIFY_TOKEN=mi_token_secreto_2024
META_TEMPLATE_NAME=recordatorio_cita_completo_v2

# ============================================================
# CONFIGURACIÓN API UOLASER
# URL base de la API interna de UOLaser
# ============================================================
API_UOLASER_URL=https://api.uolaser.com
API_UOLASER_USUARIO=tu_usuario
API_UOLASER_CONTRASENIA=tu_contrasenia

# Lista de médicos a consultar, separados por punto y coma (;)
# Ejemplo: PEREZ JUAN;GOMEZ MARIA;RODRIGUEZ CARLOS
API_UOLASER_MEDICOS=MEDICO UNO;MEDICO DOS;MEDICO TRES

# ============================================================
# CONTACTO PARA CANCELACIONES (se incluye en el mensaje)
# ============================================================
WHATSAPP_CONTACTO=320 680 3362
TELEFONO_FIJO=606 3253000

# ============================================================
# CRON SCHEDULE
# Por defecto: 6:00 PM diario (para enviar recordatorios del día siguiente)
# Formato: minuto hora * * * (cron estándar)
# ============================================================
CRON_SCHEDULE=0 18 * * *
TZ=America/Bogota

# ============================================================
# SERVIDOR
# ============================================================
PORT=3000
WEBHOOK_PATH=/webhooks/whatsapp

# ============================================================
# GOOGLE SHEETS (opcional — registro automático en hoja de cálculo)
# URL del Apps Script desplegado como aplicación web
# ============================================================
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_AQUI/exec

# ============================================================
# ENTORNO Y LOGS
# ============================================================
NODE_ENV=development
LOG_LEVEL=info
